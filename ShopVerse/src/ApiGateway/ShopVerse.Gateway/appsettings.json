{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Secret": "ShopVerse-Super-Secret-Key-2024-MinLength32Chars!",
    "Issuer": "ShopVerse.Identity",
    "Audience": "ShopVerse.Client"
  },

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "identity-swagger": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/swagger/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/identity" }
        ]
      },
      "products-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}"
        }
      },
      "catalog-swagger": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/swagger/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/catalog" }
        ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/api/v1/basket/{**catch-all}"
        }
      },
      "basket-swagger": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/swagger/basket/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/basket" }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      },
      "order-swagger": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/swagger/order/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/order" }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/payment/{**catch-all}"
        }
      },
      "payment-swagger": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/swagger/payment/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/payment" }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/v1/notification/{**catch-all}"
        }
      },
      "notification-swagger": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/swagger/notification/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/notification" }
        ]
      },
      "cargo-route": {
        "ClusterId": "cargo-cluster",
        "Match": {
          "Path": "/api/v1/cargo/{**catch-all}"
        }
      },
      "cargo-swagger": {
        "ClusterId": "cargo-cluster",
        "Match": {
          "Path": "/swagger/cargo/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/cargo" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "http://shopverse.identity.api:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://shopverse.catalog.api:8080/"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket-destination": {
            "Address": "http://shopverse.basket.api:8080/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-destination": {
            "Address": "http://shopverse.order.api:8080/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "http://shopverse.payment.api:8080/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-destination": {
            "Address": "http://shopverse.notification.api:8080/"
          }
        }
      },
      "cargo-cluster": {
        "Destinations": {
          "cargo-destination": {
            "Address": "http://shopverse.cargo.api:8080/"
          }
        }
      }
    }
  },

  "RateLimiting": {
    "PermitLimit": 100,
    "WindowInSeconds": 60,
    "ReplenishmentPeriodInSeconds": 10,
    "QueueLimit": 2,
    "SegmentsPerWindow": 8
  }
}
