{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Secret": "ShopVerse-Super-Secret-Key-2024-MinLength32Chars!",
    "Issuer": "ShopVerse.Identity",
    "Audience": "ShopVerse.Client"
  },

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/catalog" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "http://shopverse.identity.api:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://shopverse.catalog.api:8080/"
          }
        }
      }
    }
  },

  "RateLimiting": {
    "PermitLimit": 100,
    "WindowInSeconds": 60,
    "ReplenishmentPeriodInSeconds": 10,
    "QueueLimit": 2,
    "SegmentsPerWindow": 8
  }
}
