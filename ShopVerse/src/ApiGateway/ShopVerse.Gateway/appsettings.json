{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Secret": "ShopVerse-Super-Secret-Key-2024-MinLength32Chars!",
    "Issuer": "ShopVerse.Identity",
    "Audience": "ShopVerse.Client"
  },

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-swagger": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/swagger/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/identity" },
          { "PathPrefix": "/swagger" }
        ]
      },
      "products-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "catalog-swagger": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/swagger/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/catalog" },
          { "PathPrefix": "/swagger" }
        ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/api/basket/{**catch-all}"
        }
      },
"basket-swagger": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/swagger/basket/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/swagger/basket" },
          { "PathPrefix": "/swagger" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "http://shopverse.identity.api:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://shopverse.catalog.api:8080/"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket-destination": {
            "Address": "http://shopverse.basket.api:8080/"
          }
        }
      }
    }
  },

  "RateLimiting": {
    "PermitLimit": 100,
    "WindowInSeconds": 60,
    "ReplenishmentPeriodInSeconds": 10,
    "QueueLimit": 2,
    "SegmentsPerWindow": 8
  }
}
